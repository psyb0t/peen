# Copy to .env and fill in. .env is Docker --env-file input. Do not source it
# from Bash because PEEN_UPSTREAMS below is raw JSON. .env is gitignored, never
# commit real credentials.
# .env.example is generated: edit internal/pkg/config/envtemplate/env.tmpl and run make generate.

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ADD_SOURCE=true
# Daily JSON audit files. Empty writes them under PEEN_STATE_DIR/logs.
# Set a path to override. The sink never records raw prompt or tool content.
# Keep this out of PEEN_CONFIG_DIR: audit records name sessions, and every
# Docker worker can read PEEN_CONFIG_DIR.
PEEN_LOG_DIRECTORY=
# How long daily files are kept, as a Go duration. Go has no day unit, so 336h
# is 14 days. It must be a whole number of days (a multiple of 24h), and 0 means
# the default.
PEEN_LOG_RETENTION=336h

# PEEN_CONFIG_DIR is the global configuration and harness directory: AGENTS.md,
# .agents/, and the optional SYSTEM.md, APPEND_SYSTEM.md, and COMPACTION.md.
# Every Docker worker receives this directory read-only, so nothing else belongs
# in it. A control worker runs as the controller's user and can write it. Set
# this to an absolute host path. A Docker controller must mount that host path
# at the same literal path inside itself and every worker.
PEEN_CONFIG_DIR={{or .ConfigDirectory "/absolute/path/to/peen/config"}}

# PEEN_STATE_DIR is the controller's own durable state: peen.db, audit logs, and
# worker sockets. No Docker worker receives it, but a control worker runs as
# the controller's user and can read it. It must not equal PEEN_CONFIG_DIR
# and neither may sit inside the other; Peen refuses to start otherwise.
PEEN_STATE_DIR={{or .StateDirectory "/absolute/path/to/peen/state"}}

# The named agent every root turn runs as. core:general-purpose is built in. A
# plain name picks a custom agent from a harness layer first and a core agent
# second, and core:<name> picks only the core one. Startup fails for an unknown
# or disabled core: name. Other plain names, including default, are resolved at
# each turn.
PEEN_AGENT=core:general-purpose

# Core skills and agents built into Peen can be turned off. Both settings take
# comma-separated core names without the core: prefix, or all. An unknown name
# stops startup. Disabling general-purpose also requires PEEN_AGENT to name one
# of your own agents, or startup fails. Uncommenting PEEN_DISABLED_CORE_AGENTS
# alone, with PEEN_AGENT as set above, fails startup.
# PEEN_DISABLED_CORE_SKILLS=planning,freshness
# PEEN_AGENT=my-agent
# PEEN_DISABLED_CORE_AGENTS=all

# The workspace root: one absolute directory. A client may open the root or any
# existing directory inside it as a workspace, and each workspace gets its own
# session. Peen starts with no sessions and creates one only when a client
# opens a workspace through POST /api/v1/sessions/open. Leaving this empty uses the
# process working directory. For a Docker controller, use the literal host path
# you mounted, not a relocated container-only path.
{{if .WorkspaceRoot}}PEEN_WORKSPACE_ROOT={{.WorkspaceRoot}}{{else}}# PEEN_WORKSPACE_ROOT=/absolute/path/to/projects{{end}}

# Where each workspace's agent runs. An agent space is `control`, which runs the
# agent where Peen runs, or `docker:<profile>`, which runs it in its own
# container. A client names an agent space and never sends an image, mount,
# network setting, or capability. docs/where-it-runs.md explains all of this.
#
# PEEN_DOCKER_PROFILES is a JSON array of named Docker profiles. A built-in
# profile named default (docker none, network bridge, sudo false) always
# exists. Each profile takes name, image, mounts, docker (none, readonly, or
# full), network (none, bridge, or host), sudo (true or false), and revision.
# docker defaults to none and sudo to false. network defaults to bridge, so set
# "network":"none" to cut a profile off the network. docker "readonly" gives
# the worker a Docker API proxy that answers only read requests: it lists and
# inspects containers, images, networks, and volumes, and streams events. It
# refuses logs, exec, create, and start, and hides environment values in
# inspect output. docker "full" mounts the controller's Docker socket into the
# worker, which is host root. A profile's image is optional: leaving it out
# runs the image published alongside this build.
#
# PEEN_DEFAULT_AGENT_SPACE is control or docker:<profile>. Empty means
# docker:default when the controller can reach a Docker daemon and control when
# it cannot. Startup fails when it is control and the controller can reach a
# Docker daemon, because a control agent could use it to become host root.
# PEEN_DOCKER_PROFILES=[{"name":"ops","network":"host","mounts":[{"source":"/srv/datasets","readOnly":true}]}]
{{if .DefaultAgentSpace}}PEEN_DEFAULT_AGENT_SPACE={{.DefaultAgentSpace}}{{else}}# PEEN_DEFAULT_AGENT_SPACE=docker:ops{{end}}

# Docker controllers launched with `--user uid:gid` need the matching host
# account name and home so a worker can recreate that account before running.
# Leave both empty for a controller on the host or a Docker controller that
# never launches Docker workers.
{{if .HostUsername}}PEEN_HOST_USERNAME={{.HostUsername}}{{else}}# PEEN_HOST_USERNAME=your-host-user{{end}}
{{if .HostHome}}PEEN_HOST_HOME={{.HostHome}}{{else}}# PEEN_HOST_HOME=/home/your-host-user{{end}}

# Worker plumbing. PEEN_WORKER_SOCKET_DIR is the root holding one directory per
# session worker and defaults to PEEN_STATE_DIR/workers; a worker receives only
# its own session's directory. PEEN_DOCKER_SOCKET is an extra socket path to
# check. Peen also checks a unix:// DOCKER_HOST and /var/run/docker.sock, and
# creates worker containers through the first socket where the Docker API
# answers. Without a reachable daemon, a Docker agent space is refused instead
# of run in the control agent space. With one, the control agent space is
# refused. A tcp:// DOCKER_HOST that accepts a connection counts too, and then
# stops startup, because Peen launches workers only through a local socket.
# PEEN_WORKER_IMAGE replaces the image of every Docker profile; empty uses each
# profile's image, then this build's own version. Set it to your own image when
# testing a local build. A worker image must come from the same Peen release as
# the controller.
# PEEN_WORKER_SOCKET_DIR=/absolute/path/to/peen/state/workers
# PEEN_DOCKER_SOCKET=/var/run/docker.sock
{{if .WorkerImage}}PEEN_WORKER_IMAGE={{.WorkerImage}}{{else}}# PEEN_WORKER_IMAGE=psyb0t/peen:vX.Y.Z{{end}}

# API. Leave PEEN_API_TOKEN empty for an unauthenticated local deployment.
PEEN_HTTP_LISTEN_ADDRESS={{or .HTTPListenAddress ":8080"}}
PEEN_API_TOKEN=

# Metrics use a separate loopback-only listener and never share the public API
# surface. A scraper must run in the same network namespace as Peen.
PEEN_METRICS_LISTEN_ADDRESS=127.0.0.1:9090

# Providers. Every provider name becomes the prefix in provider/model, such as
# zai/glm-5.3. AIGate (https://github.com/psyb0t/aigate) is OpenAI-compatible.
# Z.ai uses its Coding API through Elelem (https://github.com/psyb0t/elelem).
# Credentials are referenced by environment variable name, never placed inside
# PEEN_UPSTREAMS. Delete every entry you do not use, together with its key
# variable. An apiKeyEnv variable that is missing or empty stops Peen from
# starting. docs/configuration.md describes each field.
PEEN_UPSTREAMS=[{"name":"aigate","type":"openai","baseUrl":"https://aigate.example/v1","apiKeyEnv":"AIGATE_TOKEN"},{"name":"zai","type":"zai-coding","baseUrl":"https://api.z.ai/api/coding/paas/v4","apiKeyEnv":"ZAI_TOKEN"}]
PEEN_DEFAULT_MODEL=zai/glm-5.3
PEEN_COMPACTION_MODEL=zai/glm-5.3-flash
AIGATE_TOKEN=REPLACE_ME
ZAI_TOKEN=REPLACE_ME

# Context and turn limits.
# PEEN_MAX_CONTEXT_TOKENS is the whole context of one request, prompt and reply
# together. When the provider publishes a context window for the selected
# model, a larger value is rejected at startup rather than failing on the first
# turn that fills it. When it publishes none, this becomes the model's context
# size.
PEEN_MAX_CONTEXT_TOKENS=32768
# PEEN_OUTPUT_RESERVE_TOKENS is the room kept for the reply inside
# PEEN_MAX_CONTEXT_TOKENS; the prompt gets the rest. 0 keeps none. Together
# with the summary room below it must be smaller than PEEN_MAX_CONTEXT_TOKENS.
PEEN_OUTPUT_RESERVE_TOKENS=4096
# PEEN_COMPACTION_MODE is drop-oldest or summarize. drop-oldest evicts whole
# conversation units from the request and stores nothing. summarize replaces an
# old completed prefix with a stored summary and never deletes transcript rows.
# Under summarize a child agent compacts its own transcript into its own stored
# summaries, separate from the session's, readable under
# /api/v1/session/agents/{agentRunId}/messages and .../compactions. drop-oldest
# stores nothing for a child either. The summary settings below are validated in
# both modes, so switching modes cannot expose a configuration startup already
# accepted.
PEEN_COMPACTION_MODE=drop-oldest
# A summary gets PEEN_COMPACTION_SUMMARY_PERCENT (1 to 50) of
# PEEN_MAX_CONTEXT_TOKENS, never more than PEEN_COMPACTION_MAX_OUTPUT_TOKENS.
# Keep the ceiling within the compaction model's output limit.
PEEN_COMPACTION_SUMMARY_PERCENT=30
PEEN_COMPACTION_MAX_OUTPUT_TOKENS=16384
# Time values are Go durations (90s, 10m, 1h30m). A bare number or an empty
# value is rejected. PEEN_COMPACTION_TIMEOUT and PEEN_TURN_TIMEOUT must be
# positive.
PEEN_COMPACTION_TIMEOUT=2m
PEEN_TURN_TIMEOUT=10m
# PEEN_CRASH_RECOVERY decides what happens to work a crashed controller or
# worker left unfinished, for every workspace this controller serves. pause
# keeps it paused until a turn asks the agent to continue it. resume lets the
# next worker continue it by itself, for deployments that run unattended.
PEEN_CRASH_RECOVERY=pause
# PEEN_MAX_CONCURRENT_TURNS bounds how many turns may run at once across every
# session in this process. It is global, unlike PEEN_MAX_CONCURRENT_AGENT_RUNS
# below, which only bounds one session's child-agent runs.
PEEN_MAX_CONCURRENT_TURNS=16
# PEEN_MAX_QUEUED_USER_MESSAGES bounds messages sent while a turn is running.
# They wait in memory until the model's current round ends, then reach the
# model in the order they were sent. At most this many can wait at once. A skill
# message or already-loaded note that follows a queued message takes a slot too.
PEEN_MAX_QUEUED_USER_MESSAGES=16

# Message size bounds. PEEN_MAX_MESSAGE_BYTES bounds the message.send
# "message" field. PEEN_MAX_SYSTEM_PROMPT_BYTES bounds its optional
# "systemPrompt.content" field. PEEN_MAX_STORED_MESSAGE_BYTES bounds any
# single message row, of any role, before it is written to the durable
# transcript, since a stored assistant or tool message is not otherwise
# bounded by a caller-facing setting.
PEEN_MAX_MESSAGE_BYTES=262144
PEEN_MAX_SYSTEM_PROMPT_BYTES=65536
PEEN_MAX_STORED_MESSAGE_BYTES=1048576

# Tool execution limits. These bound work and context, they are NOT permission
# gates. Peen's host tools run with the same access as the operating-system
# user running the process, with no sandbox, allowlist, or approval step. Use
# Docker, the container user, and the mounts you choose as the isolation
# boundary.
PEEN_MAX_TOOL_ROUNDS=32
PEEN_MAX_CONCURRENT_TOOLS=4
# For PEEN_TOOL_TIMEOUT, PEEN_TOOL_COMMAND_TIMEOUT, PEEN_TOOL_MAX_COMMAND_TIMEOUT,
# and PEEN_HOOK_COMMAND_TIMEOUT, 0 means the default and a negative value fails
# startup.
PEEN_TOOL_TIMEOUT=15m
PEEN_MAX_TOOL_RESULT_TOKENS=8192

# Per-operation output bounds.
PEEN_TOOL_MAX_LIST_ENTRIES=1000
PEEN_TOOL_MAX_LIST_DEPTH=16
PEEN_TOOL_MAX_SEARCH_MATCHES=200
PEEN_TOOL_MAX_SEARCH_FILE_BYTES=2097152
PEEN_TOOL_MAX_READ_BYTES=262144
PEEN_TOOL_MAX_READ_LINES=2000
PEEN_TOOL_MAX_WRITE_BYTES=4194304
PEEN_TOOL_MAX_EDITS=64
PEEN_TOOL_MAX_DIFF_BYTES=65536
PEEN_TOOL_MAX_REMOVE_ENTRIES=20000
PEEN_TOOL_MAX_COMMAND_OUTPUT_BYTES=65536
PEEN_TOOL_COMMAND_TIMEOUT=2m
PEEN_TOOL_MAX_COMMAND_TIMEOUT=15m

# Hooks from every .agents/hooks.yaml layer run, the workspace's included.
# Hook commands run as direct executables, never shell source, with
# structured invocation JSON on stdin.
PEEN_HOOK_COMMAND_TIMEOUT=30s
PEEN_MAX_HOOK_COMMAND_OUTPUT=65536

# Session notices and delivery. Peen reserves the job. and agent. type
# namespaces for itself, and both /api/v1/session/notices and hooks refuse them.
# Every other prefix is yours, so an app can POST an app.error notice to
# /api/v1/session/notices. Notice bodies are untrusted input and reach the model
# quoted as data. A notice starts a turn only when a handler for its type
# exists at <layer>/.agents/events/<type>.md in any harness layer. A handler
# that sets delivery decides. One that leaves it out uses the notice's own
# delivery. The API rejects a summary or data over the two size limits below,
# and a hook that emits one fails its action. Peen shortens its own job. and
# agent. summaries and leaves out over-size data. A wake cap of 0 removes the
# cap. The wake count lives in memory and starts over on restart.
PEEN_MAX_PENDING_EVENTS=256
PEEN_MAX_EVENT_SUMMARY_BYTES=4096
PEEN_MAX_EVENT_DATA_BYTES=65536
PEEN_MAX_EVENT_WAKES_PER_HOUR=60

# Child agent limits. launchAgent shares this turn's session, workspace,
# resolved rules, tool registry, and model with the agent it launches; these
# bound how deep a chain of child agents may nest, how many tool rounds one
# child conversation may run, how many agent runs one session may have in
# flight at once, how much of a run's recent event history stays available
# to follow it in flight, and how large an inline ad-hoc agentDefinition's
# instructions may be.
PEEN_MAX_CHILD_AGENT_DEPTH=5
PEEN_MAX_CHILD_AGENT_TURNS=16
PEEN_MAX_CONCURRENT_AGENT_RUNS=4
PEEN_MAX_AGENT_RUN_EVENT_COUNT=2000
PEEN_MAX_AGENT_RUN_EVENT_BYTES=65536
PEEN_MAX_ADHOC_AGENT_INSTRUCTION_BYTES=65536

# How long the ask tool waits for an answer, as a Go duration such as 30m. A
# call may ask for a shorter wait. 0 waits up to the 30-day cap of the
# messaging tools, and a waiting child agent holds one of the session's agent
# run slots until someone answers or stops it. The root's ask still ends with its turn, at
# PEEN_TURN_TIMEOUT.
PEEN_ASK_TIMEOUT=0

# Settings for the peen command. The controller ignores them.
# PEEN_CONTROL_SPACE is where Peen itself runs: host runs the Peen binary on
# this machine, and docker runs it in a container.
# PEEN_IMAGE is the Peen release image this install runs. The peen command pins
# it, and peen upgrade changes it.
# PEEN_CONTAINER_NAME is the controller container's name in the docker control
# space.
{{if .ControlSpace}}PEEN_CONTROL_SPACE={{.ControlSpace}}{{else}}# PEEN_CONTROL_SPACE=docker{{end}}
{{if .Image}}PEEN_IMAGE={{.Image}}{{else}}# PEEN_IMAGE=psyb0t/peen:vX.Y.Z{{end}}
{{if .ContainerName}}PEEN_CONTAINER_NAME={{.ContainerName}}{{else}}# PEEN_CONTAINER_NAME=peen-your-host-user{{end}}
