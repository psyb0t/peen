# Node supplies the pinned frontend toolchain. The Go and Node Alpine images
# share musl, so copying /usr/local keeps the dev image single-purpose without
# relying on an unpinned apk package.
FROM node:22.22.0-alpine@sha256:e4bf2a82ad0a4037d28035ae71529873c069b13eb0455466ae0bc13363826e34 AS node

# Example user Dockerfile.dev
# This file demonstrates how to override the framework development image
# Delete this file to use the default framework image (Dockerfile.servicepack.dev)

# Pinned by digest, not by tag. A tag is mutable and lets an upstream
# republish different bytes under the same name. Bump deliberately.
FROM golang:1.26.11-alpine@sha256:ae52b5bc6ed045a9ed26ab03dc19327a802a9cc9aa8b27ed57f5c6b60579b0bb

COPY --from=node /usr/local /usr/local

# Install build dependencies. build-retry retries each fetch with backoff, so
# a DNS or mirror blip on the build host does not fail the image.
COPY docker/build-retry.sh /usr/local/bin/build-retry
RUN sh /usr/local/bin/build-retry apk add --no-cache \
    make \
    gcc \
    musl-dev \
    bash \
    curl \
    docker-cli \
    docker-cli-buildx \
    git \
    jq \
    shellcheck \
    shfmt \
    python3 \
    py3-pip

# semgrep for the security scan (make sec). Modern semgrep works on alpine musl.
RUN sh /usr/local/bin/build-retry pip install --break-system-packages --no-cache-dir semgrep==1.173.0

# Set working directory
WORKDIR /app

# Copy source code
COPY . .

# Set env vars
ENV ENV=dev
ENV LOG_LEVEL=debug
ENV LOG_FORMAT=text
ENV LOG_ADD_SOURCE=true
ENV SERVICES_ENABLED=
ENV GOPROXY=https://proxy.golang.org,direct
ENV GOSUMDB=sum.golang.org

# Default command: show available make targets
CMD ["make", "help"]
