{
	"name": "peen-control-surface",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.28.1",
	"scripts": {
		"build": "svelte-kit sync && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
		"format": "prettier --write .",
		"generate:api": "openapi-typescript ${PEEN_API_SPEC:-../api/api.yml} --output src/lib/api/generated.ts",
		"lint": "eslint . && prettier --check .",
		"prebuild": "openapi-typescript ${PEEN_API_SPEC:-../api/api.yml} --output src/lib/api/generated.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"openapi-fetch": "0.17.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "24.13.5",
		"eslint": "10.0.1",
		"eslint-plugin-no-unsanitized": "4.1.5",
		"eslint-plugin-security": "4.0.1",
		"eslint-plugin-svelte": "3.23.0",
		"jsdom": "30.0.1",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.7",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"typescript": "5.9.3",
		"typescript-eslint": "8.57.0",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	},
	"pnpm": {
		"minimumReleaseAge": 10080,
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
