{
	"name": "peen-control-surface",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.28.1",
	"scripts": {
		"build": "svelte-kit sync && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
		"format": "prettier --write .",
		"generate:api": "openapi-typescript ${PEEN_API_SPEC:-../api/api.yml} --output src/lib/api/generated.ts",
		"lint": "eslint . && prettier --check .",
		"prebuild": "openapi-typescript ${PEEN_API_SPEC:-../api/api.yml} --output src/lib/api/generated.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"openapi-fetch": "0.17.0",
		"svelte-exmarkdown": "5.0.2"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "24.19.2",
		"eslint": "10.14.0",
		"eslint-plugin-no-unsanitized": "4.1.5",
		"eslint-plugin-security": "4.2.1",
		"eslint-plugin-svelte": "3.24.0",
		"jsdom": "30.1.3",
		"openapi-typescript": "7.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.1.0"
	},
	"pnpm": {
		"minimumReleaseAge": 10080,
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"overrides": {
			"cookie": "0.7.2",
			"minimatch": "11.0.2"
		}
	}
}
